# mk が自動生成する（HOST_UID / HOST_GID / DOCKER_NETWORK_MTU はホストの実測値で埋まる）。
# 手で作る場合は cp .env.example .env して値を調整すること。

# コンテナ内で生成されるファイルの所有者（ホストの id -u / id -g）
HOST_UID=1000
HOST_GID=1000

# ウェアハウス代わりの Postgres
POSTGRES_USER=dbt
POSTGRES_PASSWORD=dbt
POSTGRES_DB=warehouse
POSTGRES_HOST_PORT=55432

# dbt の既定スキーマ（各チュートリアルは +schema: tNN でこの後ろに付ける）
DBT_POSTGRES_SCHEMA=analytics

# Docker ブリッジの MTU（WSL2 / VPN 環境向け。ホストの ip link show の値に合わせる）
DOCKER_NETWORK_MTU=1420
